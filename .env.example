# =============================================================
# SDMAS v2 — Backend Configuration Template
# =============================================================
# Copy this file to `.env` and adjust for your environment.
#
#   cp .env.example .env
#
# NEVER commit a real `.env` file. Every value below is a safe placeholder;
# production requires real secrets (the app refuses to boot with placeholder
# secrets when ENVIRONMENT=production).
#
# See docs/SECRETS.md for the rotation & hygiene checklist.

APP_NAME=SDMAS API
ENVIRONMENT=development
DEBUG=true

# --- Database -------------------------------------------------
# SQLite for local dev, PostgreSQL for production.
DATABASE_URL=sqlite+aiosqlite:///./sdmas_dev.db
# DATABASE_URL=postgresql+asyncpg://sdmas:sdmas@localhost:5432/sdmas
DATABASE_ECHO=false
DB_POOL_SIZE=10
DB_POOL_MAX_OVERFLOW=20

# --- Redis (optional) -----------------------------------------
REDIS_URL=redis://localhost:6379/0

# --- Reverse proxy / rate limiting ----------------------------
# IPs/CIDRs of reverse proxies whose X-Forwarded-For / X-Forwarded-Proto
# headers are trusted when resolving the real client IP.  In production set
# this to the nginx / load-balancer addresses (e.g. the docker network
# CIDR).  NEVER set to "*" - that lets clients forge their IP and bypass
# IP-keyed rate limiting and audit attribution.
# TRUSTED_PROXIES=127.0.0.1,172.16.0.0/12
# NOTE: the 172.16.0.0/12 default covers docker-default networks only.  If
# your compose network is 10.x/192.168.x, set this to your real proxy subnet
# — otherwise forwarded headers are ignored and every client collapses to the
# proxy's IP for rate limiting (conservative/safe, but coarser limits).
# When true, a Redis outage fails CLOSED (429) on protected endpoints;
# default false = fail-open (allow through + log a warning).
# RATE_LIMIT_FAIL_CLOSED=false

# --- Worker / scheduler / outbox ------------------------------
# WORKER_IN_PROCESS runs the job+outbox workers inside the API process.
# Keep FALSE in production - use the dedicated worker container.
WORKER_IN_PROCESS=false
SCHEDULER_ENABLED=true
SCHEDULER_POLL_INTERVAL=60.0
OUTBOX_POLL_INTERVAL=2.0
OUTBOX_BATCH_SIZE=10
OUTBOX_MAX_ATTEMPTS=10
OUTBOX_REAP_INTERVAL=60.0
OUTBOX_STALE_AFTER=600.0

# --- Auth (JWT) -----------------------------------------------
# CHANGE ME. Use a long random value (e.g. `openssl rand -hex 64`).
JWT_SECRET=change-me-to-a-real-secret-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# --- Email (SendGrid) -----------------------------------------
SENDGRID_API_KEY=change-me-sendgrid-api-key
EMAIL_FROM_ADDRESS=noreply@example.com
EMAIL_FROM_NAME=SDMAS

# --- Payments (Razorpay) --------------------------------------
RAZORPAY_KEY_ID=change-me-razorpay-key-id
RAZORPAY_KEY_SECRET=change-me-razorpay-key-secret
# Must be distinct from the key secret; used to verify webhooks.
RAZORPAY_WEBHOOK_SECRET=change-me-razorpay-webhook-secret

# --- Document storage -----------------------------------------
STORAGE_BACKEND=local
STORAGE_ROOT=./storage
MAX_FILE_SIZE_MB=20
# Comma-separated allow-list (empty = built-in default allow-list).
ALLOWED_MIME_TYPES=
# Used to sign document download URLs. CHANGE ME in production.
DOCUMENT_STORAGE_SECRET=change-me-doc-secret

# --- AI / embeddings (optional integrations) ------------------
# Only needed when the AI/embedding features are enabled.
LLM_PROVIDER=
LLM_MODEL=
LLM_ENDPOINT=
LLM_API_KEY=
LITELLM_BASE_URL=
LITELLM_API_KEY=
LITELLM_MODEL=
LITELLM_DROP_PARAMS=true
EMBEDDING_PROVIDER=
EMBEDDING_MODEL=
EMBEDDING_ENDPOINT=
EMBEDDING_API_KEY=
EMBEDDING_DIMENSIONS=
COGNEE_SKIP_CONNECTION_TEST=true

# --- Logging / CORS -------------------------------------------
LOG_LEVEL=INFO
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]
