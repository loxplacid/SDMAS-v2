# SDMAS v2 — Backend Configuration
# Copy this file to .env and adjust for your environment.
# NEVER commit the actual .env file.

APP_NAME=SDMAS API
ENVIRONMENT=development
DEBUG=true

# Database — SQLite for local dev, PostgreSQL for production
DATABASE_URL=sqlite+aiosqlite:///./sdmas_dev.db
# DATABASE_URL=postgresql+asyncpg://sdmas:sdmas@localhost:5432/sdmas

# Redis (optional for development)
REDIS_URL=redis://localhost:6379/0

# JWT
JWT_SECRET=change-me-to-a-real-secret-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Logging
LOG_LEVEL=DEBUG

# CORS
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]