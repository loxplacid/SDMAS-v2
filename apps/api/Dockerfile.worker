# =============================================================
# SDMAS v2 — Background Worker Dockerfile
# =============================================================

FROM python:3.11-slim AS builder

WORKDIR /build

COPY requirements.txt .
# --prefix (not --user): pip --user lands in /root/.local, and /root is
# 0700 root:root on Debian slim — the runtime user could never traverse
# into it.  /opt/sdmas is world-readable by default.
# requirements.txt is generated from uv.lock (pinned + hashed), so
# --require-hashes makes every build install byte-identical wheels and
# rejects any package that lacks a recorded hash.
RUN pip install --no-cache-dir --require-hashes --prefix=/opt/sdmas -r requirements.txt

FROM python:3.11-slim

# Base-layer hygiene: apply any Debian security fixes released since the
# base image tag was built, and refresh the bundled build tooling (pip's
# setuptools/wheel ship CVEs that are fixed in newer lines).
RUN apt-get update && apt-get upgrade -y --no-install-recommends && \
    pip install --no-cache-dir --upgrade setuptools wheel && \
    rm -rf /var/lib/apt/lists/*

RUN groupadd -r sdmas && useradd -r -g sdmas -d /app -s /sbin/nologin sdmas

WORKDIR /app

COPY --from=builder /opt/sdmas /opt/sdmas

ENV PATH=/opt/sdmas/bin:$PATH \
    PYTHONPATH=/opt/sdmas/lib/python3.11/site-packages \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

COPY app/ ./app/

# Packages live under /opt/sdmas (world-readable), so the runtime user
# needs no special traversal rights — ownership of the app code only.
# Pre-create /app/storage (shared with the API via compose storage_data)
# with sdmas ownership so the worker can read/write uploaded files.
RUN mkdir -p /app/storage && chown -R sdmas:sdmas /app

USER sdmas

# The worker is a background process (`python -m app.domains.jobs.worker`), not
# a web server — it does not listen on any port.  A truthful healthcheck for a
# background process would require a heartbeat or a sidecar.  The container
# relies on the `restart: unless-stopped` policy instead: if the process exits
# abnormally Docker restarts it.  HEALTHCHECK NONE avoids the dishonesty of
# checking the API port (which the worker does not serve).
HEALTHCHECK NONE

CMD ["python", "-m", "app.domains.jobs.worker"]
