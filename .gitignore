# Python
__pycache__/
*.py[cod]
*.egg-info/
dist/
build/
*.egg
.venv/
venv/
env/
*.db

# mypy
.mypy_cache/

# pytest
.pytest_cache/

# Environment — never track real secrets. Example files are allow-listed.
.env
.env.*
!.env.example

# IDE
.idea/
.vscode/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# Evidence artifacts — generated by `make security-audit` / ./enterprise audit.
# Keep the deterministic generator scripts + docs; never commit the generated
# scanner outputs, SBOM copies, junit files or checksums (they change every run).
artifacts/security/*.json
artifacts/sbom/*.json
artifacts/sbom/validate.txt
artifacts/tests/*.xml
artifacts/SHA256SUMS
artifacts/artifact-manifest.json
artifacts/tests/test-manifest.json

# Node
node_modules/

# Testing
coverage/
htmlcov/
junit.xml

# Aider
.aider*

# Docker
*.log
.env
